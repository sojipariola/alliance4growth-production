# .env.example

NODE_ENV=production
PORT=5000
# Keep production data outside the source tree when possible.
DB_PATH=/var/lib/alliance4growth/a4g_database.sqlite
UPLOAD_DIR=/var/lib/alliance4growth/uploads
FRONTEND_URL=https://www.example.org.uk
JWT_SECRET=390dad34a35d45cf2835a9701c4f7a48c2e9f395d203a000577578f1874f3a3e7e200120061123a608d04babe34014f4
JWT_EXPIRE=7d
# Required only for the first admin initialization. Do not commit real values.
ADMIN_EMAIL=admin@alliance4growth.org
ADMIN_PASSWORD=Soji@1111
# Optional reverse-proxy trust. Set to 1 when Node is behind Nginx.
TRUST_PROXY=1
# Optional limits
JSON_LIMIT=1mb

# Bank transfer details (required to enable bank transfer donations)
BANK_NAME=Your Bank Name
BANK_ACCOUNT_NAME=Your CIC Legal Account Name
BANK_ACCOUNT_NUMBER=00000000
BANK_SORT_CODE=00-00-00
BANK_SWIFT_CODE=
BANK_IBAN=
BANK_INSTRUCTIONS=Please use the supplied reference when making your donation.

# Keep false until a real card payment provider and verified webhook are implemented.
PAYMENTS_ENABLED=false
